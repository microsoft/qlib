# Qlib local development environment (copy to .env; never commit .env).
# All values use ${VAR} references in configs; no secrets are hardcoded.

# Data / provider
QLIB_PROVIDER_URI=~/.qlib/qlib_data/cn_data
QLIB_REGION=cn

# Experiment tracking (mlflow file store disabled by default upstream)
MLFLOW_ALLOW_FILE_STORE=true
QLIB_MLFLOW_URI=file:./mlruns
QLIB_MLFLOW_EXP_NAME=Experiment

# Runtime
QLIB_LOG_LEVEL=INFO
QLIB_KERNELS=4
PYTHONUNBUFFERED=1

# Optional: live-trading / online serving credentials (leave empty locally)
# QLIB_TRADE_API_KEY=
# QLIB_TRADE_API_SECRET=
# QLIB_DATA_API_TOKEN=
